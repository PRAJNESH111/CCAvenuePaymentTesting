{
  "expo": {
    "name": "frontend",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "avenue-testing",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "paytm",
          "phonepe",
          "tez",
          "credpay",
          "bhim",
          "mobikwik",
          "freecharge",
          "amazonpay",
          "navi",
          "kiwi",
          "payzapp",
          "jupiter",
          "omnicard",
          "icici",
          "popclubapp",
          "sbiyono",
          "myjio",
          "slice-upi",
          "bobupi",
          "shriramone",
          "whatsapp",
          "com.rediff.pay",
          "hdfcbanknb",
          "aunb",
          "yonolitenb",
          "yesirisnb",
          "fedmobilenb",
          "axisbanknb"
        ],
        "NSCameraUsageDescription": "Camera permission is required to scan card details securely."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.prajneshk200111.frontend"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/withCCAvenue",
      [
        "expo-stallion-plugin",
        {
          "projectId": "6a8d2ff70940997c5ca12272",
          "appToken": "spb_ap_XloanHmJb_XxS0l837NjvoMOyoiKtanjbnPiXIZxT1"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
